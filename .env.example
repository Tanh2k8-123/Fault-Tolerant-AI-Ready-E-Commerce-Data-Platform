# Copy to .env and set local credentials before starting Docker Compose.
MINIO_ROOT_USER=
# At least 8 characters. Single-quote values containing $ or # in .env.
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=ecommerce
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
AIRFLOW_PORT=8080

# Host-side clients. Keep endpoint port in sync with MINIO_API_PORT.
MINIO_ENDPOINT_URL=http://127.0.0.1:9000
DUCKDB_PATH=./data/ecommerce.duckdb
DBT_TARGET=local
RAW_DIR=./data/raw
# Airflow reads this batch from MinIO into its own persistent DuckDB file.
PIPELINE_BATCH_ID=demo01
